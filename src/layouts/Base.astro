---
import '../styles.css';
import { SITE_NAME } from '../data/site';
interface Props { title: string; description: string; image?: string; imageAlt?: string; }
const { title, description, image='/images/plaza-espana-hero.jpg', imageAlt='Plaza España en Córdoba, Argentina' } = Astro.props;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : undefined;
const ogImage = site ? new URL(image, site).toString() : undefined;
---
<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#17201d" />
  <title>{title}</title>
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta name="application-name" content={SITE_NAME} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:alt" content={imageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" />
  <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Plaza España" />
  <script is:inline>
    (() => {
      const consent = localStorage.getItem('pe-cookie-consent');
      if (!consent) return;
      try {
        const prefs = JSON.parse(consent);
        if (!prefs.analytics) return;
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP';
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments)}
        gtag('js', new Date());
        gtag('config', 'G-HXM22WWPKP', { anonymize_ip: true });
      } catch {}
    })();
  </script>
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  </script>
</head>
<body><slot /></body>
</html>
