---
import '../styles.css';
import { SITE_NAME } from '../data/site';
interface Props { title: string; description: string; image?: string; imageAlt?: string; noindex?: boolean; }
const { title, description, image='/images/plaza-espana-hero.jpg', imageAlt='Plaza España en 2010 · Miguel Angel Roca · CC BY-SA 3.0', noindex=false } = Astro.props;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : undefined;
const ogImage = site ? new URL(image, site).toString() : undefined;
---
<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#17201d" />
  <title>{title}</title>
  {!noindex && canonical && <link rel="canonical" href={canonical} />}
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta name="application-name" content={SITE_NAME} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:image:alt" content={imageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" />
  <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Plaza España" />
  <script>
    import { initializeAnalytics } from '../lib/analytics';
    initializeAnalytics();
    if ('serviceWorker' in navigator) window.addEventListener('load',()=>navigator.serviceWorker.register('/sw.js').catch(()=>{}));
  </script>
</head>
<body><slot /></body>
</html>
